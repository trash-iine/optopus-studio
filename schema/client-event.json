{
  "$defs": {
    "Interrupt": {
      "additionalProperties": false,
      "description": "The user stopped the agent's turn.",
      "properties": {
        "type": {
          "const": "interrupt",
          "default": "interrupt",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "Interrupt",
      "type": "object"
    },
    "SelectAgent": {
      "additionalProperties": false,
      "description": "The user chose another agent for the project's chat.",
      "properties": {
        "agent": {
          "enum": [
            "claude",
            "codex"
          ],
          "title": "Agent",
          "type": "string"
        },
        "type": {
          "const": "select_agent",
          "default": "select_agent",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "agent"
      ],
      "title": "SelectAgent",
      "type": "object"
    },
    "SelectModel": {
      "additionalProperties": false,
      "description": "The user chose the model and effort the agent runs on; None for the default.",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "type": {
          "const": "select_model",
          "default": "select_model",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "SelectModel",
      "type": "object"
    },
    "SelectRevision": {
      "additionalProperties": false,
      "description": "The user chose a revision to show.",
      "properties": {
        "rev": {
          "title": "Rev",
          "type": "integer"
        },
        "type": {
          "const": "select_revision",
          "default": "select_revision",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rev"
      ],
      "title": "SelectRevision",
      "type": "object"
    },
    "SetWebSearch": {
      "additionalProperties": false,
      "description": "The user let the agent search the web, or stopped it.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "set_web_search",
          "default": "set_web_search",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "SetWebSearch",
      "type": "object"
    },
    "UserMessage": {
      "additionalProperties": false,
      "description": "A message the user sent to the agent.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "user_message",
          "default": "user_message",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "UserMessage",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "interrupt": "#/$defs/Interrupt",
      "select_agent": "#/$defs/SelectAgent",
      "select_model": "#/$defs/SelectModel",
      "select_revision": "#/$defs/SelectRevision",
      "set_web_search": "#/$defs/SetWebSearch",
      "user_message": "#/$defs/UserMessage"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/UserMessage"
    },
    {
      "$ref": "#/$defs/SelectRevision"
    },
    {
      "$ref": "#/$defs/Interrupt"
    },
    {
      "$ref": "#/$defs/SelectAgent"
    },
    {
      "$ref": "#/$defs/SetWebSearch"
    },
    {
      "$ref": "#/$defs/SelectModel"
    }
  ],
  "title": "ClientEvent"
}
