      ],
      "title": "BarView",
      "type": "object"
    },
    "CustomHtmlView": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "default": 400,
          "maximum": 2000,
          "minimum": 100,
          "title": "Height",
          "type": "integer"
        },
        "html": {
          "description": "A whole document, drawn in a sandboxed iframe with scripts on.",
          "title": "Html",
          "type": "string"
