    "RunSummary": {
      "additionalProperties": false,
      "description": "What the GUI keeps of one solve, also stored as a revision's result.json.",
      "properties": {
        "best_run": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Run"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkerError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "heuristics": {
          "default": [],
          "description": "The variants as solved, with any override of solve.json applied; empty in a result.json older than the field.",
          "items": {
            "$ref": "#/$defs/Variant"
          },
          "title": "Heuristics",
          "type": "array"
        },
        "higher_is_better": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Higher Is Better"
        },
        "live": {
          "anyOf": [
            {
              "$ref": "#/$defs/LiveRun"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Problem"
        },
        "rev": {
          "title": "Rev",
          "type": "integer"
        },
        "runs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RunFinished"
          },
          "title": "Runs",
          "type": "array"
        },
        "seed": {
          "anyOf": [
