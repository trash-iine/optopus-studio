          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "lane",
        "label",
        "start",
        "end",
        "group"
      ],
      "title": "GanttTask",
      "type": "object"
    },
    "GanttView": {
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "items": {
            "$ref": "#/$defs/GanttTask"
