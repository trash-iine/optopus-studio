{
  "$defs": {
    "BenchBest": {
      "additionalProperties": false,
      "description": "The best objective known on one instance of the benchmark.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "number"
        },
        "source": {
          "description": "What found it, such as 'evaluation 4'.",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "objective",
        "source"
      ],
      "title": "BenchBest",
      "type": "object"
    },
    "BenchCandidate": {
      "additionalProperties": false,
      "description": "One saved candidate, a line of the ledger: a hypothesis and what became of it.",
      "properties": {
        "adopted": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The revision it was adopted as, if it was.",
          "title": "Adopted"
        },
        "baseline_rev": {
          "description": "The revision it changes, and is judged against.",
          "title": "Baseline Rev",
          "type": "integer"
        },
        "evaluation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its latest evaluation, if it was judged.",
          "title": "Evaluation"
        },
        "evidence": {
          "description": "What suggested it: a reading, a sign, a source.",
          "title": "Evidence",
          "type": "string"
        },
        "family": {
          "enum": [
            "settings",
            "heuristic",
            "composition",
            "neighborhood",
            "delta",
            "representation",
            "start",
            "port"
          ],
          "title": "Family",
          "type": "string"
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gain"
        },
        "hypothesis": {
          "description": "What it changes and why that should help.",
          "title": "Hypothesis",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "lesson": {
          "description": "What its result taught, in the agent's words.",
          "title": "Lesson",
          "type": "string"
        },
        "variant": {
          "description": "The heuristic of its solve.json it runs.",
          "title": "Variant",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "better",
                "mixed",
                "same",
                "worse",
                "rejected",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verdict"
        }
      },
      "required": [
        "id",
        "baseline_rev",
        "family",
        "hypothesis",
        "evidence",
        "variant",
        "evaluation",
        "verdict",
        "gain",
        "adopted",
        "lesson"
      ],
      "title": "BenchCandidate",
      "type": "object"
    },
    "BenchEvaluation": {
      "additionalProperties": false,
      "description": "One evaluation of a change against a baseline revision (bench.py).",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/BenchSide"
        },
        "candidate": {
          "$ref": "#/$defs/BenchSide"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why a candidate was rejected or failed.",
          "title": "Detail"
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The mean gain over all pairs; null unless judged.",
          "title": "Gain"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "instances": {
          "items": {
            "$ref": "#/$defs/BenchInstanceResult"
          },
          "title": "Instances",
          "type": "array"
        },
        "kept": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The later revision whose files are the candidate's, if it was solved into one.",
          "title": "Kept"
        },
        "note": {
          "description": "What the candidate changes, as the agent said it.",
          "title": "Note",
          "type": "string"
        },
        "p_better": {
          "title": "P Better",
          "type": "number"
        },
        "p_worse": {
          "title": "P Worse",
          "type": "number"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "test",
            "all"
          ],
          "title": "Split",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "better",
            "mixed",
            "same",
            "worse",
            "rejected",
            "failed"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "worsening": {
          "description": "The mean worsening over the instances, one way.",
          "title": "Worsening",
          "type": "number"
        }
      },
      "required": [
        "id",
        "split",
        "candidate",
        "baseline",
        "note",
        "verdict",
        "gain",
        "worsening",
        "p_better",
        "p_worse",
        "detail",
        "instances",
        "kept"
      ],
      "title": "BenchEvaluation",
      "type": "object"
    },
    "BenchInstance": {
      "additionalProperties": false,
      "description": "One instance of the benchmark, kept under bench/instances.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "description": "Of the instance file, so a result says what it ran on.",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "description": "Where the instance came from, such as 'revision 3'.",
          "title": "Source",
          "type": "string"
        },
        "split": {
          "description": "Candidates are chosen on train; the final choice is checked on validation; test only measures what is reported, and decides nothing.",
          "enum": [
            "train",
            "validation",
            "test"
          ],
          "title": "Split",
          "type": "string"
        }
      },
      "required": [
        "name",
        "split",
        "source",
        "sha256"
      ],
      "title": "BenchInstance",
      "type": "object"
    },
    "BenchInstanceResult": {
      "additionalProperties": false,
      "description": "How the candidate did against the baseline on one instance.",
      "properties": {
        "baseline": {
          "description": "The baseline's mean best objective.",
          "title": "Baseline",
          "type": "number"
        },
        "candidate": {
          "description": "The candidate's mean best objective.",
          "title": "Candidate",
          "type": "number"
        },
        "gain": {
          "description": "The mean gain over the paired runs, relative to the baseline's mean objective; + is better.",
          "title": "Gain",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "better",
            "same",
            "worse"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "name",
        "gain",
        "outcome",
        "baseline",
        "candidate"
      ],
      "title": "BenchInstanceResult",
      "type": "object"
    },
    "BenchProfile": {
      "additionalProperties": false,
      "description": "One profile of several heuristics on the benchmark (profiling.py, docs/adr/0015).",
      "properties": {
        "fractions": {
          "description": "The shares of the budget 'anytime' is read at.",
          "items": {
            "type": "number"
          },
          "title": "Fractions",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "instances": {
          "items": {
            "type": "string"
          },
          "title": "Instances",
          "type": "array"
        },
        "p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Friedman test's p-value over all runs.",
          "title": "P"
        },
        "readings": {
          "description": "Compositions the profile suggests, as hints for the next variants.",
          "items": {
            "type": "string"
          },
          "title": "Readings",
          "type": "array"
        },
        "rev": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The revision profiled; null for the work files.",
          "title": "Rev"
        },
        "split": {
          "enum": [
            "train",
            "validation",
            "all"
          ],
          "title": "Split",
          "type": "string"
        },
        "variants": {
          "items": {
            "$ref": "#/$defs/BenchProfileVariant"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rev",
        "split",
        "instances",
        "fractions",
        "p",
        "variants",
        "readings"
      ],
      "title": "BenchProfile",
      "type": "object"
    },
    "BenchProfileVariant": {
      "additionalProperties": false,
      "description": "How one heuristic behaved in a profile.",
      "properties": {
        "accepted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The share of moves accepted.",
          "title": "Accepted"
        },
        "anytime": {
          "description": "The mean gap of its best so far to the best any heuristic found on the instance, relative to that best, at each of the profile's fractions of the budget.",
          "items": {
            "type": "number"
          },
          "title": "Anytime",
          "type": "array"
        },
        "best_found_at": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The mean share of the budget spent when a run found its best.",
          "title": "Best Found At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why its runs failed; the rest is null then.",
          "title": "Error"
        },
        "iterations_per_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iterations Per Sec"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "mean_rank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Over the runs, 1 the best.",
          "title": "Mean Rank"
        },
        "p_vs_best": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Conover's p-value against the best; under 0.05 it is clearly worse.",
          "title": "P Vs Best"
        },
        "wins": {
          "description": "Instances on which its mean objective is the best.",
          "title": "Wins",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "error",
        "mean_rank",
        "p_vs_best",
        "wins",
        "anytime",
        "best_found_at",
        "iterations_per_sec",
        "accepted"
      ],
      "title": "BenchProfileVariant",
      "type": "object"
    },
    "BenchRace": {
      "additionalProperties": false,
      "description": "One race of several candidates against a baseline revision (candidates.py).",
      "properties": {
        "baseline": {
          "$ref": "#/$defs/BenchSide"
        },
        "baseline_rank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Rank"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/BenchRaceEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Friedman test's p-value over all runs.",
          "title": "P"
        },
        "winner": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The best-ranked candidate judged better than the baseline, if any.",
          "title": "Winner"
        }
      },
      "required": [
        "id",
        "baseline",
        "baseline_rank",
        "p",
        "entries",
        "winner"
      ],
      "title": "BenchRace",
      "type": "object"
    },
    "BenchRaceEntry": {
      "additionalProperties": false,
      "description": "How one candidate did in a race.",
      "properties": {
        "candidate": {
          "title": "Candidate",
          "type": "integer"
        },
        "evaluation": {
          "description": "Its evaluation against the baseline, from the race.",
          "title": "Evaluation",
          "type": "integer"
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Gain"
        },
        "mean_rank": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Over the runs, 1 the best, among the baseline and the candidates judged.",
          "title": "Mean Rank"
        },
        "verdict": {
          "enum": [
            "better",
            "mixed",
            "same",
            "worse",
            "rejected",
            "failed"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "candidate",
        "evaluation",
        "verdict",
        "gain",
        "mean_rank"
      ],
      "title": "BenchRaceEntry",
      "type": "object"
    },
    "BenchSide": {
      "additionalProperties": false,
      "description": "One side of an evaluation: whose files, which heuristic, which worker.",
      "properties": {
        "candidate_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The saved candidate the side ran, if it is one (docs/adr/0018).",
          "title": "Candidate Id"
        },
        "rev": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rev"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        },
        "where": {
          "description": "'the work files', 'revision <n>' or 'candidate <n>'.",
          "title": "Where",
          "type": "string"
        },
        "worker": {
          "enum": [
            "python",
            "rust"
          ],
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "where",
        "rev",
        "variant",
        "worker",
        "candidate_id"
      ],
      "title": "BenchSide",
      "type": "object"
    },
    "BenchSpec": {
      "additionalProperties": false,
      "description": "bench/bench.json: the instances and the budget every evaluation runs with.",
      "properties": {
        "instances": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BenchInstance"
          },
          "title": "Instances",
          "type": "array"
        },
        "max_duration_secs": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 1.0,
          "description": "Each run's time limit, which replaces the stop of every evaluated heuristic.",
          "title": "Max Duration Secs"
        },
        "max_iteration": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Each run's iteration limit, instead of or as well as the time.",
          "title": "Max Iteration"
        },
        "runs": {
          "default": 5,
          "description": "Runs per instance and side, paired by seed.",
          "maximum": 50,
          "minimum": 1,
          "title": "Runs",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "exclusiveMaximum": 18446744073709551616,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "instances",
        "runs",
        "seed",
        "max_duration_secs",
        "max_iteration"
      ],
      "title": "BenchSpec",
      "type": "object"
    },
    "BenchTuning": {
      "additionalProperties": false,
      "description": "One tuning of a heuristic's settings by racing (tune.py).",
      "properties": {
        "best": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The best settings by parameter path; null when the revision's own stayed.",
          "title": "Best"
        },
        "best_variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The variant of the best settings when several were raced; null otherwise, or when the revision's own stayed.",
          "title": "Best Variant"
        },
        "budget": {
          "title": "Budget",
          "type": "integer"
        },
        "eliminated": {
          "title": "Eliminated",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "rev": {
          "title": "Rev",
          "type": "integer"
        },
        "settings": {
          "description": "The settings raced.",
          "title": "Settings",
          "type": "integer"
        },
        "signs": {
          "description": "What the race shows that settings cannot fix, as hints for the next change.",
          "items": {
            "type": "string"
          },
          "title": "Signs",
          "type": "array"
        },
        "used": {
          "description": "The runs made.",
          "title": "Used",
          "type": "integer"
        },
        "validation": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The evaluation that checked them on validation.",
          "title": "Validation"
        },
        "variants": {
          "description": "The variants raced: one, or several to choose among, the first the one the others were measured against.",
          "items": {
            "type": "string"
          },
          "title": "Variants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rev",
        "variants",
        "used",
        "budget",
        "settings",
        "eliminated",
        "failed",
        "best",
        "best_variant",
        "validation",
        "signs"
      ],
      "title": "BenchTuning",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GET /api/projects/{id}/bench: the benchmark and everything judged or measured on it.",
  "properties": {
    "best": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchBest"
      },
      "title": "Best",
      "type": "array"
    },
    "candidates": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "evaluations": {
      "items": {
        "$ref": "#/$defs/BenchEvaluation"
      },
      "title": "Evaluations",
      "type": "array"
    },
    "profiles": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchProfile"
      },
      "title": "Profiles",
      "type": "array"
    },
    "races": {
      "default": [],
      "items": {
        "$ref": "#/$defs/BenchRace"
      },
      "title": "Races",
      "type": "array"
    },
    "spec": {
      "$ref": "#/$defs/BenchSpec"
    },
    "tunings": {
      "items": {
        "$ref": "#/$defs/BenchTuning"
      },
      "title": "Tunings",
      "type": "array"
    }
  },
  "required": [
    "spec",
    "evaluations",
    "tunings",
    "profiles",
    "candidates",
    "races",
    "best"
  ],
  "title": "BenchState",
  "type": "object"
}
