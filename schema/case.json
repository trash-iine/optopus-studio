          "title": "Solution"
        },
        "time_to_best_secs": {
          "title": "Time To Best Secs",
          "type": "number"
        },
        "total_time_secs": {
          "title": "Total Time Secs",
          "type": "number"
        },
        "trajectory": {
          "description": "(elapsed_secs, iteration, objective) for every improvement of the best.",
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "title": "Trajectory",
          "type": "array"
        },
        "type": {
          "const": "run_finished",
          "default": "run_finished",
          "title": "Type",
          "type": "string"
        },
        "variant": {
